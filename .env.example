# k-parent-skills — 환경변수 템플릿
# 사용법: cp .env.example .env 후 값을 채우세요. (.env 는 .gitignore 로 커밋되지 않음)
# 키 발급 안내와 라이브 fixture 재생성 명령은 OWNER-TASKS.md 참고.

# --- 키 없는 조회용 프록시 (선택) ---
# 비우면 k-skill 공개 프록시(https://k-skill-proxy.nomadamas.org)를 쓴다. docs/kskill-proxy.md 참고.
KSKILL_PROXY_BASE_URL=

# --- 학교/영양 (NEIS 교육정보 개방포털: https://open.neis.go.kr) ---
KEDU_INFO_KEY=

# --- 학교알리미 Open API (https://www.schoolinfo.go.kr) ---
# 초중고 35종 공시(학업성취·급식·교육여건·평가계획 등). SNS 로그인으로 즉시 발급.
SCHOOLINFO_API_KEY=

# --- 유치원알리미 Open API (https://e-childschoolinfo.moe.go.kr) ---
# 유치원 기본현황 14종(기본·급식·통학차량·방과후 등). 개발계정 자동승인.
CHILDSCHOOLINFO_API_KEY=

# --- 공공데이터포털 통합키 (https://www.data.go.kr) ---
# 놀이시설/도시공원, 어린이보호구역/스쿨존, 어린이집/유치원, 응급의료(e-gen) 서비스에 공용.
# 서비스별 활용신청 필요.
KSKILL_DATAGOKR_KEY=

# --- 한국관광공사 TourAPI 4.0 (놀이/축제/여행) ---
KSKILL_TOURAPI_KEY=

# --- 서울 열린데이터광장 (공공서비스예약: https://data.seoul.go.kr) ---
KSKILL_SEOUL_KEY=

# --- 도서관 정보나루 (https://data4library.kr/apiUtilization) ---
KSKILL_LIBRARY_KEY=

# --- 문화포털 공연/전시 (https://www.culture.go.kr) ---
KSKILL_CULTURE_KEY=

# --- 네이버 검색/쇼핑 API (https://developers.naver.com) ---
KSKILL_NAVER_CLIENT_ID=
KSKILL_NAVER_CLIENT_SECRET=

# --- 쿠팡 파트너스 (어필리에이트, 보조 수익: https://partners.coupang.com) ---
KSKILL_COUPANG_ACCESS_KEY=
KSKILL_COUPANG_SECRET_KEY=

# --- YouTube Data API v3 (Google Cloud Console) ---
KSKILL_YOUTUBE_KEY=

# --- K-Parent local runtime (localhost only) ---
# JSON bearer token -> opaque tenant ID mapping. 실제 값은 .env 또는 secret manager에만 둔다.
KPARENT_API_TOKEN_TENANTS=
# 아래 둘은 optional encrypted local memory를 쓸 때 반드시 함께 설정한다.
KPARENT_MEMORY_FILE=
KPARENT_MEMORY_KEY_BASE64=
